# Shared bearer token required by every /v1 route except /v1/health.
# Use a long random value locally and set the same value with
# `npx wrangler secret put API_TOKEN` in production.
API_TOKEN=4ee7a6cd899310f584dee47126a42f583061425484dfaab90f70b34ba8757035

# Optional. Name of the D1 binding declared in wrangler.jsonc (default: afika).
DB_BINDING=afika

# Optional. Comma-separated browser origins allowed by CORS, or "*".
# API_ALLOWED_ORIGINS=http://localhost:8081

# Optional Privy access-token verification. The API fetches signing keys from
# the app-specific JWKS endpoint; set the matching app ID below.
# PRIVY_APP_ID=your-privy-app-id
# PRIVY_APP_SECRET=your-privy-app-secret

# Website sign-in (server-rendered /signin and /account).
#
# PRIVY_APP_ID enables the email one-time-code flow and PRIVY_APP_SECRET lets
# the account page read the signed-in profile. PRIVY_CLIENT_ID is the app
# client id from the Privy dashboard (the same value as privyClientId in
# app/app.json). When that client requires a registered native app identifier,
# set PRIVY_NATIVE_APP_ID to the allowlisted bundle id (phumzile.afika.pos).
#
# SESSION_SECRET signs the HttpOnly session cookie. Use a long random value
# locally and set the same value with `npx wrangler secret put SESSION_SECRET`
# in production. Without it the sign-in pages report that sign-in is disabled.
# PRIVY_CLIENT_ID=your-privy-client-id
# PRIVY_NATIVE_APP_ID=phumzile.afika.pos
# SESSION_SECRET=replace-with-a-long-random-value
