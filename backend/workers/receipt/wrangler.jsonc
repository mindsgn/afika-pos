/**
 * For more details on how to configure Wrangler refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "afika-receipt",
	"main": "./build/worker.mjs",
	"compatibility_date": "2026-10-23",
	"triggers": {
		// Once a minute: POS checkout links live for 30 minutes.
		"crons": [
			"* * * * *"
		]
	},
	"previews": {},
	"build": {
		"command": "npm run build"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			// Shared database: backend/api owns pos_payments writes, this worker
			// reconciles them against wallet_transactions.
			"binding": "afika",
			"database_name": "afika",
			"database_id": "b806cd75-548d-4abc-be85-213a7ba18c6a",
			"migrations_dir": "migrations"
		}
	]
	/**
	 * DB_BINDING is optional; it defaults to "afika" in main_wasm.go.
	 */
	// "vars": { "DB_BINDING": "afika" }
}
