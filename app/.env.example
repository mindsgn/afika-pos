# Payments API used to create shareable checkout links and poll their status.
EXPO_PUBLIC_API_URL=https://pos.phumzile.studio
# Optional legacy bearer token. The app uses the signed-in Privy access token
# for online checkout when available; leave this blank for normal setups.
EXPO_PUBLIC_API_TOKEN=
# Optional: public origin used in the QR/link handed to customers. Defaults to
# EXPO_PUBLIC_API_URL, which serves /pay/{id} itself.
EXPO_PUBLIC_CHECKOUT_URL=
# Privy app id/client id and ZeroDev project id enable the Wallet tab.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_ZERODEV_ID=
# End-to-end tests only. scripts/e2e.sh sets this when it starts Metro so the
# sign-in screen accepts a fixed code instead of sending a real Privy email.
# EXPO_PUBLIC_E2E=1
